# Frontend Supabase Configuration (Public)
# These are client-safe variables pointing to your Supabase project API gateway.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-here"

# Note: Never expose Supabase service_role keys, database passwords, or SMS API secrets in client .env files!
# Server-side Edge Functions configure backend secrets in Supabase Dashboard -> Project Settings -> Vault / Secrets.

